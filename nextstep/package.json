{
  "name": "nextstep",
  "private": true,
  "version": "0.1.0",
  "description": "NextStep — UK career discovery and progression prototype",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "e2e": "node scripts/e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build:preview": "VITE_TARGET=artifact vite build && node scripts/build-preview.mjs",
    "refresh-data": "python3 scripts/fetch_ncs.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.55.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^5.0.3"
  }
}
