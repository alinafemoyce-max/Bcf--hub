# WoodmillFlow configuration. Copy to .env.local (local) or add in your host's settings (Vercel).
# Every setting is optional for a laptop-hosted demonstration.

# --- Database -----------------------------------------------------------------------------
# Leave empty to use the built-in embedded database stored in .data/pglite (laptop demo).
# Set to a PostgreSQL connection string for a hosted deployment (Neon, Supabase, Vercel Postgres).
# POSTGRES_URL is also accepted (set automatically by some Vercel integrations).
DATABASE_URL=

# --- Public address -------------------------------------------------------------------------
# The address phones should use. Used for the QR code. Example: https://woodmillflow-demo.vercel.app
# If empty, the address you opened the app with is used (or the laptop's network address).
APP_URL=

# --- Private demonstration ------------------------------------------------------------------
# If set, every page asks for this code (the QR code includes it, so scanning still works).
# Recommended for any internet-hosted demonstration.
DEMO_ACCESS_CODE=

# Required to reset demo data when using a hosted DATABASE_URL.
DEMO_RESET_PIN=

# Demo role switching. Set to "false" to disable the role switch; operator screens then refuse
# access because enterprise sign-in has not been built.
DEMO_MODE=true

# --- Clock-number rule (placeholder, not a real company format) ------------------------------
NEXT_PUBLIC_CLOCK_NUMBER_FORMAT=numeric
NEXT_PUBLIC_CLOCK_NUMBER_MIN_LENGTH=4
NEXT_PUBLIC_CLOCK_NUMBER_MAX_LENGTH=8
