# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Required. The password you type to sign in (use something long; it is the only lock on your data).
APP_PASSWORD=

# Required in production. Postgres connection string (Neon via Vercel Storage sets this automatically,
# or paste Supabase's "Transaction pooler" URI). Leave empty locally to use the embedded dev database.
DATABASE_URL=

# Optional: enables the Claude screenshot reader (the free on-phone reader needs no key).
# Create at https://console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-5-5 (cheapest). claude-sonnet-5-5 or claude-opus-5-5 read more carefully but cost more.
ANTHROPIC_MODEL=

# Optional. Maximum AI requests per 24 hours (default 150).
AI_DAILY_LIMIT=

# Optional. Session signing key (16+ random characters). If unset, one is derived from APP_PASSWORD + DATABASE_URL.
SESSION_SECRET=
